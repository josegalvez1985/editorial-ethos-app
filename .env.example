# Copia este archivo a `.env`.
# El bloque de verificación de `backend/ethos_auth.sql` imprime la URL real.

# --- Frontend web (Vite / TanStack Start) --------------------------------
# Ruta que usa el navegador. Déjala en /api/ords/ para pasar por el proxy
# server-side: mismo origen, sin CORS y el token fuera de la URL.
VITE_API_URL=/api/ords/

# --- Proxy server-side (src/routes/api/ords.$.ts) ------------------------
# Nunca llegan al navegador. Requiere deploy CON servidor Node.
ORDS_TARGET=https://oracleapex.com
ORDS_PREFIX=/ords/fundcarac/ethos/
