<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo, en vector.

  Antes aca vivia la grilla verde (#26A69A) que genera Android Studio al crear
  el proyecto: nunca fue de la marca. Hoy es el azul del logo, liso.

  En la practica gana el PNG de mipmap-*/ic_launcher_background.png, que es lo
  que referencia mipmap-anydpi-v26/ic_launcher.xml. Este vector queda como
  respaldo del mismo color para que ninguna ruta de recursos pueda volver a
  mostrar el verde de la plantilla.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <path
        android:fillColor="#7095CC"
        android:pathData="M0,0h108v108h-108z" />
</vector>
